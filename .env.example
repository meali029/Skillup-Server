###############################
# SERVER CONFIGURATION
###############################
# Application environment (development | production)
NODE_ENV=production

# Port where backend will run
PORT=5000

# Backend API URL (used for email verification links)
# Local: http://localhost:5000
# Production: https://your-api-domain.com
API_URL=http://localhost:5000


###############################
# JWT AUTHENTICATION
###############################
# JWT token expiry time (example: 30m, 1h, 7d)
JWT_EXPIRES_IN=30m

# Generate your secret here: https://generate-secret.vercel.app/32
JWT_SECRET=your_jwt_secret_here


###############################
# DATABASE CONFIGURATION
###############################
# Get your MongoDB URI from: https://cloud.mongodb.com/
# Format:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>


###############################
# REDIS CONFIGURATION
###############################
# Redis URL for sessions, caching, rate limiting, BullMQ, and Socket.IO adapter
# Local: redis://localhost:6379
# Production: redis://<host>:<port> or rediss://<host>:<port> for TLS
REDIS_URL=redis://localhost:6379


###############################
# SESSION & COOKIE SETTINGS
###############################
# Generate random string for session security
SESSION_SECRET=your_session_secret_here

# Use "true" in production with HTTPS
COOKIE_SECURE=false


###############################
# CLIENT URL
###############################
# Frontend development server or production URL
CLIENT_URL=http://localhost:5173

# FRONTEND_URL is used for email verification links and OAuth redirects
# Use this for environment-safe redirects (same as CLIENT_URL in most cases)
FRONTEND_URL=http://localhost:5173


###############################
# GOOGLE OAUTH SETTINGS
###############################
# Create keys from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Should match the authorized redirect URI in Google Console
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback


###############################
# EMAIL SMTP CONFIGURATION
###############################
# Use Gmail or your SMTP provider
EMAIL_HOST=smtp.gmail.com

# Gmail SMTP port (587 for TLS)
EMAIL_PORT=587

# Your email address (Gmail recommended)
EMAIL_USER=your_email_here@gmail.com

# Create Gmail App Password:
# https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_email_app_password_here

# Optional: enable nodemailer debug output (set true temporarily to capture SMTP details)
EMAIL_DEBUG=false

# Optional: SMTP connection verify timeout (ms)
EMAIL_CONNECTION_TIMEOUT=10000

# Optional: set to true when using SMTPS on port 465
EMAIL_SECURE=false

# Production email provider options:
# - resend (recommended on Railway)
# - sendgrid
# - nodemailer (SMTP/local/dev)
EMAIL_FROM="SkillUp <no-reply@yourdomain.com>"
EMAIL_REPLY_TO=support@yourdomain.com
# RESEND_API_KEY=your_resend_api_key_here
# SENDGRID_API_KEY=your_sendgrid_api_key_here


###############################
# CNIC OCR FEATURE
###############################
# Enable / disable CNIC OCR feature
ENABLE_CNIC_OCR=true

# OCR Confidence threshold (0-100)
# Results below this threshold are marked as low_confidence
OCR_CONFIDENCE_THRESHOLD=70

# Optional: separate OCR service URL. In production, point this to the
# standalone Skillup-OCR-Service Railway URL to keep EasyOCR out of Node.
OCR_SERVICE_URL=
OCR_SERVICE_API_KEY=
OCR_SERVICE_TIMEOUT_MS=180000


###############################
# CLOUDINARY CONFIGURATION
###############################
# Get credentials from: https://cloudinary.com/console
# Sign up for free account: https://cloudinary.com/users/register/free

# Your Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary API Key
CLOUDINARY_API_KEY=your_api_key

# Cloudinary API Secret (keep this secret!)
CLOUDINARY_API_SECRET=your_api_secret


###############################
# AI SYSTEM CONFIGURATION
###############################
AI_ENABLED=true
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600


###############################
# GEMINI AI PROVIDER SETTINGS
###############################
# Get API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_TOKENS=512
GEMINI_TEMPERATURE=0.5
GEMINI_TIMEOUT=15000


###############################
# AI RATE LIMITS
###############################
AI_RATE_LIMIT_PROPOSAL=5
AI_RATE_LIMIT_MATCH=20
AI_RATE_LIMIT_GLOBAL=200


###############################
# CIRCUIT BREAKER SETTINGS
###############################
AI_CB_ERROR_THRESHOLD=0.1
AI_CB_TIME_WINDOW=300000
AI_CB_RECOVERY_TIME=300000


###############################
# FEATURE FLAGS
###############################
AI_FEATURE_JOB_RECOMMENDATIONS=true
AI_FEATURE_FREELANCER_RECOMMENDATIONS=true
AI_FEATURE_PROPOSAL_GENERATION=true
AI_FEATURE_MATCH_SCORE=true


###############################
# SAFEPAY PAYMENT GATEWAY
###############################
# Get keys from: https://sandbox.api.getsafepay.com/dashboard/developers/api
SAFEPAY_API_KEY=sec_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SAFEPAY_SECRET_KEY=your_safepay_secret_key_here
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret_here
SAFEPAY_SANDBOX=true
SAFEPAY_CALLBACK_URL=http://localhost:5000/api/payments/callback/safepay
# Pending Safepay transactions older than this (in hours) are auto-marked failed
SAFEPAY_PENDING_TIMEOUT_HOURS=24
