# Server Configuration
PORT=5000

# Database Configuration
# Get your MongoDB URI from: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/Skill_Up?retryWrites=true&w=majority&appName=YourApp

# JWT Configuration
# Generate a secure random string for production (minimum 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-64-characters-long-change-this
JWT_EXPIRES_IN=30m

# Session Configuration
# Generate a secure random string (minimum 32 characters)
SESSION_SECRET=your-super-secret-session-key-min-32-characters-change-this

# Cookie Security
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# Client Configuration
# URL where your React client is running
CLIENT_URL=http://localhost:5173

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID
# 2. Add authorized origins: http://localhost:5173, http://localhost:5000
# 3. Add authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Additional Notes:
# - Copy this file to .env and fill in your actual values
# - Never commit .env file to git (it's in .gitignore)
# - In production, use environment variables from your hosting platform
# - Generate strong secrets for JWT_SECRET and SESSION_SECRET